# Copy to .env and adjust. Never commit .env.

POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=gitea

# Use your VPS IP or hostname here, not localhost, if you want to reach it remotely
GITEA_DOMAIN=localhost
GITEA_PORT=3000
GITEA_SSH_PORT=2222

# Generate with: docker run --rm gitea/gitea:1.24 gitea generate secret SECRET_KEY
GITEA_SECRET_KEY=replace-with-generated-secret

# Admin account created by bootstrap.sh
GITEA_ADMIN_USER=arkadmin
GITEA_ADMIN_PASSWORD=change-me-too-8chars
GITEA_ADMIN_EMAIL=admin@example.com

# Seed volume
SEED_USERS=50
SEED_REPOS_PER_USER=4
